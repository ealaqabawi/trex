"""
Local trigger server for n8n scheduling.

This n8n instance has no Execute Command (or similar shell-access) node
registered — likely disabled for security — so n8n can't shell out to
`python3 -m reports.daily_summary` directly. This tiny HTTP server bridges
that gap: n8n's Schedule Trigger calls an HTTP Request node against
GET /run-cycle, which runs the same pipeline and returns the summary text.

Binds to 127.0.0.1 only — not reachable outside this machine.
"""

import json
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse, parse_qs

from reports.daily_summary import build_summary
from utils.logger import get_logger

log = get_logger("trigger_server")

HOST = "127.0.0.1"
PORT = 8787
DEFAULT_WATCHLIST = ["AAPL", "NVDA", "SPY"]


_CAPITAL_MTIME = None


def _capital_feed():
    """Import service.capital_feed, reloading it when the file changes (no server restart needed)."""
    global _CAPITAL_MTIME
    import importlib
    import os

    from service import capital_feed

    mtime = os.path.getmtime(capital_feed.__file__)
    if _CAPITAL_MTIME is not None and mtime != _CAPITAL_MTIME:
        capital_feed = importlib.reload(capital_feed)
        log.info("capital_feed reloaded")
    _CAPITAL_MTIME = mtime
    return capital_feed


class Handler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):  # noqa: A002
        log.info("%s - %s", self.client_address[0], format % args)

    def do_GET(self):
        parsed = urlparse(self.path)

        if parsed.path == "/control":
            page = Path(__file__).with_name("control_panel.html")
            try:
                self._respond_html(200, page.read_bytes())
            except OSError as e:
                log.error("control panel unavailable: %s", e)
                self._respond(500, {"status": "error", "detail": "control panel unavailable"})
            return

        if parsed.path in ("/control/status", "/control/gate"):
            from service.scanner_control import mark_gate_check, read_state

            state = mark_gate_check() if parsed.path == "/control/gate" else read_state()
            if parsed.path == "/control/status":
                state.update(mode="alerts_only", broker_execution=False)
            self._respond(200, state)
            return

        if parsed.path == "/health":
            self._respond(200, {"status": "ok"})
            return

        if parsed.path == "/run-cycle":
            query = parse_qs(parsed.query)
            tickers = query.get("tickers", [",".join(DEFAULT_WATCHLIST)])[0].split(",")
            try:
                summary = build_summary(tickers)
                self._respond(200, {"status": "ok", "summary": summary})
            except Exception as e:  # noqa: BLE001
                log.error("run-cycle failed: %s", e)
                self._respond(500, {"status": "error", "detail": str(e)})
            return

        if parsed.path == "/signal":
            query = parse_qs(parsed.query)
            tickers = query.get("tickers", [",".join(DEFAULT_WATCHLIST)])[0].split(",")
            only_actionable = query.get("actionable", ["false"])[0].lower() == "true"
            try:
                from dataclasses import asdict
                from service.signal_engine import build_signal, render_telegram, render_compact
                from reports.signal_log import log_signal

                signals = []
                for t in tickers:
                    sig = build_signal(t.strip())
                    if only_actionable and sig.direction == "NEUTRAL":
                        continue
                    log_signal(asdict(sig))  # feedback loop: only LONG/SHORT persist
                    signals.append({**asdict(sig), "telegram": render_telegram(sig),
                                     "compact": render_compact(sig)})

                signals.sort(key=lambda s: s["confidence"], reverse=True)
                self._respond(200, {
                    "status": "ok",
                    "count": len(signals),
                    "signals": signals,
                    # compact text for the LLM agents — see render_compact()
                    "prompt": "\n".join(s["compact"] for s in signals)
                               or "No actionable signals today.",
                    "telegram": "\n\n".join(s["telegram"] for s in signals)
                                 or "No actionable signals today.",
                })
            except Exception as e:  # noqa: BLE001
                log.error("signal failed: %s", e)
                self._respond(500, {"status": "error", "detail": str(e)})
            return

        if parsed.path == "/review":
            try:
                from reports.signal_log import review_pending, recent_hit_rate
                result = review_pending()
                self._respond(200, {"status": "ok", "reviewed": result,
                                     "hit_rate": recent_hit_rate()})
            except Exception as e:  # noqa: BLE001
                log.error("review failed: %s", e)
                self._respond(500, {"status": "error", "detail": str(e)})
            return

        if parsed.path == "/candles":
            # OHLCV candles in Yahoo chart-API shape for the n8n "Trex Universal" scanner and Hermes.
            # source=auto (default): Capital.com prices when credentials are set, Yahoo (yfinance) otherwise
            # or if Capital.com fails. source=capital / source=yahoo forces one feed.
            query = parse_qs(parsed.query)
            symbol = query.get("symbol", [""])[0].strip()
            interval = query.get("interval", ["5m"])[0]
            period = query.get("range", ["5d"])[0]
            source = query.get("source", ["auto"])[0].lower()
            if not symbol:
                self._respond(400, {"status": "error", "detail": "symbol required"})
                return
            capital_feed = _capital_feed()

            capital_error = None
            if source in ("auto", "capital") and capital_feed.CLIENT.configured:
                try:
                    self._respond(200, capital_feed.candles(symbol, interval))
                    return
                except Exception as e:  # noqa: BLE001
                    capital_error = str(e)
                    log.warning("Capital.com candles failed for %s: %s", symbol, e)
            if source == "capital":
                self._respond(502, {"status": "error",
                                    "detail": capital_error or "Capital.com credentials not set"})
                return
            try:
                import yfinance as yf

                df = yf.Ticker(symbol).history(period=period, interval=interval,
                                               auto_adjust=False, actions=False)
                df = df.dropna(subset=["Open", "High", "Low", "Close"])
                meta = {"symbol": symbol, "interval": interval, "source": "yahoo"}
                if capital_error:
                    meta["capital_error"] = capital_error[:200]
                self._respond(200, {"chart": {"error": None, "result": [{
                    "meta": meta,
                    "timestamp": [int(t.timestamp()) for t in df.index],
                    "indicators": {"quote": [{
                        "open": [float(x) for x in df["Open"]],
                        "high": [float(x) for x in df["High"]],
                        "low": [float(x) for x in df["Low"]],
                        "close": [float(x) for x in df["Close"]],
                        "volume": [float(x) for x in df["Volume"].fillna(0)],
                    }]},
                }]}})
            except Exception as e:  # noqa: BLE001
                log.error("candles failed for %s: %s", symbol, e)
                self._respond(500, {"status": "error", "detail": str(e)})
            return

        if parsed.path == "/quote":
            # Live Capital.com bid/offer, spread, market status and client sentiment (read-only).
            query = parse_qs(parsed.query)
            symbol = query.get("symbol", [""])[0].strip()
            if not symbol:
                self._respond(400, {"status": "error", "detail": "symbol required"})
                return
            capital_feed = _capital_feed()

            try:
                self._respond(200, capital_feed.quote(symbol))
            except Exception as e:  # noqa: BLE001
                log.warning("quote failed for %s: %s", symbol, e)
                self._respond(502, {"status": "error", "source": "capital.com", "detail": str(e)[:300]})
            return

        if parsed.path == "/alerts/review":
            # Forward test: how did the alerts the scanner actually sent turn out (target vs stop)?
            from service import alert_journal

            capital_feed = _capital_feed()
            days = float(parse_qs(parsed.query).get("days", ["30"])[0])
            try:
                self._respond(200, alert_journal.review(lambda s: capital_feed.candles(s, "5m"), days))
            except Exception as e:  # noqa: BLE001
                self._respond(500, {"status": "error", "detail": str(e)[:300]})
            return

        if parsed.path == "/capital/status":
            capital_feed = _capital_feed()

            status = {"configured": capital_feed.CLIENT.configured, "env": capital_feed.CLIENT.env}
            if status["configured"] and parse_qs(parsed.query).get("check", ["0"])[0] == "1":
                try:
                    status.update(ok=True, **capital_feed.CLIENT.login_check())
                except Exception as e:  # noqa: BLE001
                    status.update(ok=False, detail=str(e)[:300])
            self._respond(200, status)
            return

        self._respond(404, {"status": "error", "detail": "unknown path"})

    def do_POST(self):
        parsed = urlparse(self.path)
        if parsed.path == "/control/state":
            try:
                length = int(self.headers.get("Content-Length") or 0)
                if length <= 0 or length > 1024:
                    self._respond(400, {"status": "error", "detail": "invalid request size"})
                    return
                payload = json.loads(self.rfile.read(length))
                if not isinstance(payload, dict) or not isinstance(payload.get("enabled"), bool):
                    self._respond(400, {"status": "error", "detail": "enabled must be a boolean"})
                    return
                from service.scanner_control import set_enabled

                state = set_enabled(payload.get("enabled"))
                self._respond(200, {"status": "ok", **state})
            except (ValueError, TypeError, json.JSONDecodeError) as e:
                self._respond(400, {"status": "error", "detail": str(e)})
            except Exception as e:  # noqa: BLE001
                log.error("control update failed: %s", e)
                self._respond(500, {"status": "error", "detail": "control update failed"})
            return

        if parsed.path == "/alerts/log":
            try:
                length = int(self.headers.get("Content-Length") or 0)
                payload = json.loads(self.rfile.read(length) or b"{}")
                from service import alert_journal

                self._respond(200, {"status": "ok", "logged": alert_journal.log_alert(payload)})
            except Exception as e:  # noqa: BLE001
                self._respond(500, {"status": "error", "detail": str(e)[:300]})
            return
        if parsed.path != "/vet":
            self._respond(404, {"status": "error", "detail": "unknown path"})
            return
        try:
            length = int(self.headers.get("Content-Length") or 0)
            payload = json.loads(self.rfile.read(length) or b"{}")
            from utils.grounding import vet_commentary

            safe, rejected = vet_commentary(payload.get("commentary", ""),
                                             payload.get("source", ""))
            if rejected:
                log.warning("Commentary rejected — ungrounded numbers %s", rejected)
            self._respond(200, {"status": "ok", "commentary": safe,
                                 "rejected": rejected, "grounded": not rejected})
        except Exception as e:  # noqa: BLE001
            log.error("vet failed: %s", e)
            # Fail closed: on any error the commentary is dropped, never passed through.
            self._respond(200, {"status": "error", "commentary": "",
                                 "rejected": ["vet-error"], "detail": str(e)})

    def _respond_html(self, code: int, body: bytes):
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _respond(self, code: int, payload: dict):
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def run():
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    log.info("Trigger server listening on http://%s:%d (run-cycle, signal, candles, quote, capital/status, alerts, health)", HOST, PORT)
    server.serve_forever()


if __name__ == "__main__":
    run()
