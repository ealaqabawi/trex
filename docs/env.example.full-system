# T-REX Trading Intelligence — environment template
#
# Copy to .env and fill in real values. NEVER commit .env.
# Anything n8n calls should ALSO live in n8n's encrypted credential store;
# this file is for the Python services only.
#
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------
# Core
# ---------------------------------------------------------------
TREX_ENV=development                 # development | production
TREX_MODE=alert_only                 # alert_only — broker execution is hard-denied in code
TREX_TIMEZONE=Asia/Riyadh            # scheduling timezone; US/Eastern is derived
TREX_LOG_LEVEL=INFO

# ---------------------------------------------------------------
# Database  (SQLite now; swap the URL for Postgres with no schema change)
# ---------------------------------------------------------------
TREX_DATABASE_URL=sqlite:///./data/trex.sqlite
# TREX_DATABASE_URL=postgresql+psycopg://trex:CHANGE_ME@localhost:5432/trex

# ---------------------------------------------------------------
# n8n orchestration  (local instance)
# ---------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=                         # Settings -> n8n API -> create key

# ---------------------------------------------------------------
# Agent LLM backend
# ---------------------------------------------------------------
OPENROUTER_API_KEY=                  # primary model backend
OLLAMA_BASE_URL=http://127.0.0.1:11434   # optional local fallback (no models pulled yet)

# ---------------------------------------------------------------
# Market + options data
# ---------------------------------------------------------------
# Massive (formerly Polygon.io). Tier and options entitlement NOT yet verified.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.polygon.io

# Optional fallback for options chains with greeks
TRADIER_API_KEY=
TRADIER_BASE_URL=https://api.tradier.com

# ---------------------------------------------------------------
# Primary-source news + macro  (open, but SEC requires a real User-Agent)
# ---------------------------------------------------------------
SEC_USER_AGENT=                      # required format: "Your Name your@email.com"
FRED_API_KEY=                        # free from fred.stlouisfed.org

# ---------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=                  # from @BotFather for @MyETRex_bot
TELEGRAM_OPERATOR_CHAT_ID=           # only this ID may run state-changing commands
TELEGRAM_ALLOWED_CHAT_IDS=           # comma-separated; read-only commands

# ---------------------------------------------------------------
# Risk limits  (enforced by the Risk Engine; breach pauses signals)
# ---------------------------------------------------------------
MAX_DAILY_LOSS_PCT=2.0
MAX_POSITION_RISK_PCT=1.0
MAX_TOTAL_EXPOSURE_PCT=20.0
MAX_OPTIONS_RISK_PCT=2.0
MAX_0DTE_RISK_PCT=0.5
MAX_CONCURRENT_TRADES=5
MAX_SIGNALS_PER_HOUR=6

# ---------------------------------------------------------------
# API budget  (hard stop per premarket/intraday cycle)
# ---------------------------------------------------------------
MAX_API_CREDITS_PER_CYCLE=2000
