# T-REX — environment configuration template
# Copy to .env and fill in real values. Never commit .env.

# --- Market Data ---
# NOT_AUTHORIZED for both options AND aggregates on this key as of 2026-09-12
# (confirmed via curl and via a live data_agent run) — plan lacks entitlement.
# Options data is sourced independently via yfinance (no key needed); see
# data/options_client.py. Fix or replace this key before Phase 5 for price data.
POLYGON_API_KEY=UNAUTHORIZED

# --- Options data — multi-adapter stack ---
# For regular equities (SPY, QQQ, NVDA, …) yfinance covers it with no key.
# For CBOE INDEX chains (SPX, NDX, RUT, VIX, DJX) Yahoo does NOT serve
# chains at all. Set EITHER of the two keys below and the dashboard will
# treat SPX as first-class.
#
# 1) Tradier — free developer account at https://developer.tradier.com
#    Covers SPX monthlies, SPXW weeklies, 0DTE. Set TRADIER_SANDBOX=true
#    while testing without a funded brokerage account.
TRADIER_API_KEY=
TRADIER_SANDBOX=false

# 2) MarketData.app — free tier (100 req/day) with Greeks and index support.
#    Signup at https://marketdata.app
MARKETDATA_APP_TOKEN=

# --- Broker / Execution ---
# PAPER TRADING ONLY. ALPACA_BASE_URL must stay pointed at paper-api — the
# execution agent hard-refuses to submit orders to any other host.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# true = log intended orders without submitting them. Keep true until you've
# reviewed execution_agent.py and deliberately want paper orders to go live.
DRY_RUN=true

# --- LLM / Agent Reasoning ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Workflow Orchestration ---
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678

# --- Notifications ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# --- Database ---
DATABASE_URL=

# --- TRAX dashboard-specific ---
# Instrument universe shown across the dashboard (0DTE scanner, options
# chain, market monitor, etc.). Comma-separated. SPX is an index — the
# dashboard charts it via ^GSPC; the Options Chain falls back to SPY.
TRAX_UNIVERSE=SPX,SPY,QQQ,NVDA

# Operating mode: research | paper | live-disabled
# live-* is deliberately not a value — there is no live execution path.
TRAX_MODE=research

# Data freshness thresholds (minutes)
TRAX_DATA_FRESHNESS_WARN_MIN=15
TRAX_DATA_FRESHNESS_STALE_MIN=60

# Local AI model (used by the Phase 9 n8n Ollama agents, documented here
# so the dashboard Settings page can display what is configured)
TRAX_LOCAL_MODEL_BACKEND=ollama
TRAX_LOCAL_MODEL_NAME=llama3.2
TRAX_LOCAL_MODEL_URL=http://localhost:11434

# Risk envelope — all configurable, defaults are conservative, not advice
TRAX_MAX_PREMIUM_PER_POS=500
TRAX_MAX_DAILY_LOSS=1000
TRAX_MAX_CONCURRENT_POS=3
TRAX_MAX_SPREAD_PCT=0.15
TRAX_MIN_VOLUME=50
TRAX_MIN_OI=250
TRAX_MAX_ORDER_SIZE=1000

# Enable settings writes (mode change) through the API. Off by default.
TRAX_ALLOW_SETTINGS_WRITE=false

# --- Telegram ---
# TRAX now sends to Telegram DIRECTLY from Python via utils/alerts.
# send_telegram_alert — the n8n workflow is optional/legacy. Create a
# bot via @BotFather in Telegram, paste the token here, then message
# the bot once from your account and grab your chat_id via
# https://api.telegram.org/bot<token>/getUpdates (look for "chat":{"id":...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# When true, service/trigger_server.py posts every actionable signal
# to Telegram automatically on top of returning it in the HTTP body.
# Off by default so this change is safe to deploy without surprising
# existing n8n consumers.
TELEGRAM_AUTOSEND=false

# --- Misc ---
LOG_LEVEL=INFO
ENVIRONMENT=development
